{
  "expo": {
    "name": "TPV$GESTION",
    "slug": "tpv-app",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "tpvapp",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a $(PRODUCT_NAME) usar la cámara para escanear códigos."
        }
      ],
      "expo-mail-composer",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "com.hichfla.tpvapp"
    },
    "extra": {
      "eas": {
        "projectId": "26170584-bfbb-48ea-99db-3da63ae084b1"
      }
    }
  }
}
