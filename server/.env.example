NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
SUPABASE_SECRET_KEY=PON_AQUI_LA_NUEVA_CLAVE_SECRETA

# Stripe - en desarrollo usa claves de TEST (sk_test_...), en producción LIVE (sk_live_...).
# Las claves reales SOLO se configuran en Render, nunca en el repositorio.
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
# Precios recurrentes mensuales creados en Stripe (price_...).
# Deben pertenecer al MISMO modo (test o live) que STRIPE_SECRET_KEY.
# Base usuario principal: 9,00 € + 21% IVA = 10,89 € / mes (IVA incluido).
STRIPE_MAIN_SUBSCRIPTION_PRICE_ID=price_REEMPLAZAR
# Usuario adicional (empleado): 2,50 € + 21% IVA = 3,03 € / mes (IVA incluido).
STRIPE_ADDITIONAL_USER_PRICE_ID=price_REEMPLAZAR
# Métodos de pago del cobro online (Checkout puntual).
# 'auto' = métodos dinámicos recomendados por Stripe: NO se envía payment_method_types y Stripe
# muestra los métodos activados en el Dashboard (tarjeta, Bizum, etc.) que sean elegibles para
# cada cliente e importe. Para forzar una lista concreta usa p. ej. 'card,bizum'.
# Bizum requiere: cuenta de Stripe en España, EUR, cobro puntual y entre 0,50 € y 5.000 €.
STRIPE_PAYMENT_METHOD_TYPES=auto

